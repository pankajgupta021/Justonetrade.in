{
  "name": "whatsapp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent Node.js service that maintains the Baileys/WhatsApp connection for JustOneTrade",
  "scripts": {
    "dev": "tsc && node dist/index.js",
    "dev:watch": "tsc --watch",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
